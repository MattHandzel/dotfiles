     assert "Nobody points at this one." not in xml
+
+
+@pytest.mark.skipif(shutil.which("pandoc") is None, reason="pandoc not installed")
+def test_pushed_footnote_markers_link_to_their_footnotes(tmp_path):
+    """Each marker is a hyperlink to a bookmark at the start of its own
+    footnote, which Drive's import turns into a clickable jump in the doc."""
+    md, _ = doc_to_markdown(_fixture("footnotes_doc.json"))
+    docx = tmp_path / "out.docx"
+    pandoc_to_docx(md, docx)
+    with zipfile.ZipFile(docx) as z:
+        body = z.read("word/document.xml").decode("utf-8")
+        notes = z.read("word/footnotes.xml").decode("utf-8")
+    links = re.findall(
+        r'<w:hyperlink w:anchor="(gdoc_sync_fn_\d+)">\s*<w:r>.*?'
+        r'<w:footnoteReference w:id="(\d+)"', body)
+    assert [a for a, _ in links] == ["gdoc_sync_fn_1", "gdoc_sync_fn_2"]
+    for anchor, note_id in links:
+        note = re.search(rf'<w:footnote w:id="{note_id}">(.*?)</w:footnote>',
+                         notes, re.S).group(1)
+        assert f'w:name="{anchor}"' in note
+
+
+def test_link_footnotes_skips_a_note_already_inside_a_link():
+    note = {"t": "Note", "c": [{"t": "Para", "c": [{"t": "Str", "c": "x"}]}]}
+    inner = {"t": "Link", "c": [["", [], []], [note], ["https://e.com", ""]]}
+    ast = {"blocks": [{"t": "Para", "c": [inner]}]}
+    assert link_footnotes(ast) == ast
