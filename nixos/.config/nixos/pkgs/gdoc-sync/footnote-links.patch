+#: A ``[^label]:`` footnote definition. It only decides whether a push takes
+#: the AST pass, so a false hit (one inside a code block) costs one pandoc run.
+_FOOTNOTE_DEF = re.compile(r"(?m)^\[\^[^\]\s]+\]:")
+
+#: Bookmark name for the n-th footnote. Word bookmark names are letters,
+#: digits and underscores, and must start with a letter.
+FOOTNOTE_BOOKMARK = "gdoc_sync_fn_{}"
+
+
+def _first_text_block(blocks: list) -> dict | None:
+    """The first ``Para``/``Plain`` in ``blocks``, however deeply nested."""
+    for node in blocks:
+        if isinstance(node, dict):
+            if node.get("t") in ("Para", "Plain"):
+                return node
+            found = _first_text_block([node.get("c")])
+        elif isinstance(node, list):
+            found = _first_text_block(node)
+        else:
+            continue
+        if found is not None:
+            return found
+    return None
+
+
+def link_footnotes(ast: dict) -> dict:
+    """Make every footnote marker a link that jumps to its footnote.
+
+    A Google Docs footnote reference is not clickable on its own. Each
+    ``Note`` is wrapped in a ``Link`` to a bookmark put at the start of the
+    footnote's text: pandoc writes a ``w:hyperlink`` around the
+    ``w:footnoteReference`` and a ``w:bookmarkStart`` inside the footnote, and
+    Drive's import keeps both, as a Docs bookmark and a marker linked to it.
+    Pull reads only the reference, so the link never reaches the markdown.
+
+    A note already inside a link is left alone (hyperlinks cannot nest), as
+    is one with no paragraph to hold the bookmark.
+    """
+    count = 0
+
+    def walk(node, in_link: bool):
+        nonlocal count
+        if isinstance(node, list):
+            return [walk(n, in_link) for n in node]
+        if not isinstance(node, dict) or "c" not in node:
+            return node
+        if node.get("t") == "Note":
+            target = None if in_link else _first_text_block(node["c"])
+            if target is None:
+                return node
+            count += 1
+            ident = FOOTNOTE_BOOKMARK.format(count)
+            target["c"].insert(0, {"t": "Span", "c": [[ident, [], []], []]})
+            return {"t": "Link", "c": [["", [], []], [node], ["#" + ident, ""]]}
+        return {**node, "c": walk(node["c"], in_link or node.get("t") == "Link")}
+
+    return {**ast, "blocks": walk(ast.get("blocks", []), False)}
+
+
