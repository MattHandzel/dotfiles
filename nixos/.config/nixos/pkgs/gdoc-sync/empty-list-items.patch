 def test_strip_frontmatter_removes_leading_block():
@@ -25,3 +36,35 @@ def test_derive_title_falls_back_to_yaml():
 
 def test_derive_title_falls_back_to_filename():
     assert derive_title("just text\n", "my-note") == "my-note"
+
+
+# An empty list item (`1.` under a heading, to be filled in later) used to
+# vanish from the doc: pandoc gives it no blocks and writes nothing for it
+# (Oops 2026-10-08).
+EMPTY_ITEMS = "### Mine\n\n1.\n\n### Theirs\n\n-\n\n## Next\n\n1. kept\n"
+
+
+@pytest.mark.skipif(shutil.which("pandoc") is None, reason="pandoc not installed")
+def test_pushed_docx_keeps_empty_list_items(tmp_path):
+    docx = tmp_path / "out.docx"
+    pandoc_to_docx(EMPTY_ITEMS, docx)
+    with zipfile.ZipFile(docx) as z:
+        body = z.read("word/document.xml").decode("utf-8")
+    items = re.findall(r"<w:p>(?:(?!</w:p>).)*?<w:numPr>(?:(?!</w:p>).)*</w:p>", body, re.S)
+    assert len(items) == 3
+    assert "<w:t" not in items[0] and "<w:t" not in items[1]
+    assert "kept" in items[2]
+
+
+def test_tab_requests_keep_empty_list_items():
+    from gdoc_sync.mdrequests import Para, markdown_to_blocks
+    paras = [b for b in markdown_to_blocks(EMPTY_ITEMS) if isinstance(b, Para) and b.list_kind]
+    assert [p.list_kind for p in paras] == ["ol", "ul", "ol"]
+
+
+def test_fill_empty_list_items_leaves_full_items_alone():
+    ast = {"blocks": [{"t": "OrderedList", "c": [[1, {"t": "Decimal"}, {"t": "Period"}],
+                                                 [[{"t": "Plain", "c": [{"t": "Str", "c": "x"}]}], []]]}]}
+    items = fill_empty_list_items(ast)["blocks"][0]["c"][1]
+    assert items[0] == [{"t": "Plain", "c": [{"t": "Str", "c": "x"}]}]
+    assert items[1] == [{"t": "Plain", "c": [{"t": "Str", "c": ""}]}]
