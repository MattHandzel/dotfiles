+#: A list marker alone on its line (``1.``, ``-``), i.e. a placeholder item
+#: still to be filled in. Like :data:`_FOOTNOTE_DEF` it only decides whether a
+#: push takes the AST pass.
+_EMPTY_LIST_ITEM = re.compile(r"(?m)^[ \t]*(?:[-*+]|\d{1,9}[.)])[ \t]*$")
+
+
+def fill_empty_list_items(ast: dict) -> dict:
+    """Give every empty list item a paragraph, so it reaches the doc.
+
+    Pandoc parses ``1.`` alone on its line as an item with no blocks, and the
+    docx writer (and :mod:`.mdrequests`) write nothing at all for such an
+    item: the list vanishes from the doc. An empty ``Plain`` is dropped too;
+    ``Plain [Str ""]`` is what makes pandoc write an empty numbered paragraph.
+    """
+    empty_item = [{"t": "Plain", "c": [{"t": "Str", "c": ""}]}]
+
+    def walk(node):
+        if isinstance(node, list):
+            return [walk(n) for n in node]
+        if not isinstance(node, dict):
+            return node
+        t = node.get("t")
+        if t == "BulletList":
+            return {**node, "c": [walk(item) or empty_item for item in node["c"]]}
+        if t == "OrderedList":
+            attrs, items = node["c"]
+            return {**node, "c": [attrs, [walk(item) or empty_item for item in items]]}
+        if "c" in node:
+            return {**node, "c": walk(node["c"])}
+        return node
+
+    return {**ast, "blocks": walk(ast.get("blocks", []))}
+
+
