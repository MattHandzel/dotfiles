     return DEFAULT_FONT
 
 
-def get_theme() -> str | None:
-    """Color theme applied on create/push, or None when disabled ("none"/"off")."""
-    theme = _setting("theme", DEFAULT_THEME)
+def get_theme(markdown: str | None = None) -> str | None:
+    """Color theme applied on create/push, or None when disabled ("none"/"off").
+
+    A file's own ``gdoc_theme:`` frontmatter key wins over the config, so one
+    kind of doc (generated meeting notes) can look different from the rest,
+    and every later push keeps that look instead of repainting the default.
+    """
+    theme = _frontmatter_theme(markdown) if markdown else None
+    if theme is None:
+        theme = _setting("theme", DEFAULT_THEME)
     if isinstance(theme, str) and theme.strip():
         t = theme.strip().lower()
         return None if t in ("none", "off", "false") else t
     return None
 
 
+def _frontmatter_theme(markdown: str) -> str | None:
+    if not markdown.startswith("---\n"):
+        return None
+    end = markdown.find("\n---", 4)
+    if end == -1:
+        return None
+    try:
+        header = yaml.safe_load(markdown[4:end])
+    except yaml.YAMLError:
+        return None
+    value = header.get("gdoc_theme") if isinstance(header, dict) else None
+    return value if isinstance(value, str) and value.strip() else None
+
+
