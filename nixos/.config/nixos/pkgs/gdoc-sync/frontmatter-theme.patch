+def test_frontmatter_gdoc_theme_overrides_config(tmp_path, monkeypatch):
+    import gdoc_sync.config as config
+
+    cfg = tmp_path / "config.yaml"
+    cfg.write_text("defaults: {theme: catppuccin-latte}\n")
+    monkeypatch.setenv("GDOC_SYNC_CONFIG", str(cfg))
+    config.set_config_override(None)
+    assert config.get_theme("---\ngdoc_theme: professional\n---\n\n# Hi\n") == "professional"
+    assert config.get_theme("---\ngdoc_theme: none\n---\nbody\n") is None
+    assert config.get_theme("---\ntitle: x\n---\nbody\n") == "catppuccin-latte"
+    assert config.get_theme("no frontmatter\n") == "catppuccin-latte"
+    assert config.get_theme("---\n: [broken\n---\nbody\n") == "catppuccin-latte"
+    assert config.get_theme() == "catppuccin-latte"
+
+
