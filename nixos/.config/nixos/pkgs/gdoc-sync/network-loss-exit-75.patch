diff --git a/src/gdoc_sync/neterr.py b/src/gdoc_sync/neterr.py
new file mode 100644
index 0000000..0967ac5
--- /dev/null
+++ b/src/gdoc_sync/neterr.py
@@ -0,0 +1,59 @@
+"""Tell "the network went away" apart from a real failure.
+
+A scheduled ``sync --all`` runs for minutes; when the Mac sleeps or changes
+Wi-Fi during it, the next Google request fails deep inside google-auth,
+httplib2 or urllib3. That is not a bug in any doc, so the CLI reports it in one
+line and exits with :data:`EXIT_NETWORK` (EX_TEMPFAIL from sysexits.h) instead
+of a traceback, and the launchd pass retries on its next tick.
+"""
+
+from __future__ import annotations
+
+import errno
+import socket
+
+EXIT_NETWORK = 75  # EX_TEMPFAIL
+
+_NET_ERRNOS = {
+    errno.ENETUNREACH, errno.ENETDOWN, errno.EHOSTUNREACH, errno.EHOSTDOWN,
+    errno.ECONNREFUSED, errno.ECONNRESET, errno.ECONNABORTED, errno.ETIMEDOUT,
+    errno.EPIPE, errno.ENETRESET,
+}
+
+
+def _network_types() -> tuple[type, ...]:
+    types: list[type] = [socket.gaierror, TimeoutError, ConnectionError]
+    try:
+        from google.auth.exceptions import TransportError
+        types.append(TransportError)
+    except ImportError:
+        pass
+    try:
+        import httplib2
+        types.append(httplib2.ServerNotFoundError)
+    except ImportError:
+        pass
+    try:
+        import requests
+        types += [requests.exceptions.ConnectionError, requests.exceptions.Timeout]
+    except ImportError:
+        pass
+    return tuple(types)
+
+
+def is_network_error(exc: BaseException | None) -> bool:
+    """True if ``exc`` or anything in its cause/context chain is a lost network.
+
+    Local errors (FileNotFoundError, PermissionError, an SSL certificate
+    failure, an HttpError from the API) are not, even though some are OSErrors.
+    """
+    types = _network_types()
+    seen: set[int] = set()
+    while exc is not None and id(exc) not in seen:
+        seen.add(id(exc))
+        if isinstance(exc, types):
+            return True
+        if type(exc) is OSError and exc.errno in _NET_ERRNOS:
+            return True
+        exc = exc.__cause__ or exc.__context__
+    return False
diff --git a/tests/test_neterr.py b/tests/test_neterr.py
new file mode 100644
index 0000000..ec325d0
--- /dev/null
+++ b/tests/test_neterr.py
@@ -0,0 +1,83 @@
+"""A lost network is a one-line, exit-75 stop, not a traceback (bug err-gdoc-sync-20261027-181808)."""
+
+import errno
+import socket
+
+import pytest
+from google.auth.exceptions import TransportError
+
+from gdoc_sync import cli
+from gdoc_sync.neterr import EXIT_NETWORK, is_network_error
+
+
+def _dns_failure():
+    try:
+        raise socket.gaierror(8, "nodename nor servname provided, or not known")
+    except socket.gaierror as e:
+        try:
+            raise TransportError("Failed to resolve 'oauth2.googleapis.com'") from e
+        except TransportError as t:
+            return t
+
+
+@pytest.mark.parametrize("exc", [
+    _dns_failure(),
+    socket.gaierror(8, "nodename nor servname provided"),
+    TimeoutError("The read operation timed out"),
+    OSError(errno.ENETUNREACH, "Network is unreachable"),
+    ConnectionResetError(errno.ECONNRESET, "reset"),
+])
+def test_network_errors_are_recognised(exc):
+    assert is_network_error(exc)
+
+
+@pytest.mark.parametrize("exc", [
+    FileNotFoundError(errno.ENOENT, "gone"),
+    PermissionError(errno.EACCES, "no"),
+    OSError(errno.ENOSPC, "disk full"),
+    ValueError("bad markdown"),
+    IndexError("list index out of range"),
+])
+def test_other_errors_are_not(exc):
+    assert not is_network_error(exc)
+
+
+def test_sync_stops_with_exit_75_and_no_error_line(tmp_path, monkeypatch, capsys):
+    import gdoc_sync.config as config
+    import gdoc_sync.sync as gsync
+
+    note = tmp_path / "note.md"
+    note.write_text("# note\n")
+    monkeypatch.setattr(config, "get_doc_id", lambda p: "1fakeDocId")
+    monkeypatch.setattr(config, "is_pull_only", lambda p: False)
+
+    def offline(*a, **k):
+        raise _dns_failure()
+
+    monkeypatch.setattr(gsync, "reconcile", offline)
+    with pytest.raises(SystemExit) as ex:
+        cli._api_guard(lambda: cli._run_sync([note], adopt=None, no_push=False,
+                                             force=False, json_lines=False))
+    assert ex.value.code == EXIT_NETWORK
+    err = capsys.readouterr().err
+    assert "ERROR" not in err and "Traceback" not in err
+    assert "can't reach Google" in err
+
+
+def test_real_crash_still_raises(tmp_path, monkeypatch, capsys):
+    import gdoc_sync.config as config
+    import gdoc_sync.sync as gsync
+
+    note = tmp_path / "note.md"
+    note.write_text("# note\n")
+    monkeypatch.setattr(config, "get_doc_id", lambda p: "1fakeDocId")
+    monkeypatch.setattr(config, "is_pull_only", lambda p: False)
+
+    def boom(*a, **k):
+        raise IndexError("list index out of range")
+
+    monkeypatch.setattr(gsync, "reconcile", boom)
+    with pytest.raises(IndexError):
+        cli._api_guard(lambda: cli._run_sync([note], adopt=None, no_push=False,
+                                             force=False, json_lines=False))
+    assert "ERROR while syncing" in capsys.readouterr().err
