 from __future__ import annotations
 
+from pathlib import Path
 import pytest
 
 from gdoc_sync import merge as m
@@ -198,3 +199,38 @@ def test_numbering_untouched_when_the_plain_merge_is_clean(merge3):
     result = merge3(ours, base, theirs)
     assert result.clean
     assert "2. b" in result.text
+
+
+_WS_FIXTURE = Path(__file__).parent / "fixtures" / "ws_merge"
+
+
+def test_trimmed_trailing_space_does_not_conflict_with_a_doc_edit(merge3):
+    # 2026-11-13 (bug err-gdoc-sync-20261113-122443): the last-synced render
+    # had an empty item "1. ", an editor save trimmed it to "1." in the vault,
+    # and the Doc grew that list. The three real sides, text anonymized.
+    ours, base, theirs = (
+        (_WS_FIXTURE / f"{n}.md").read_text(encoding="utf-8")
+        for n in ("ours", "base", "theirs")
+    )
+    result = merge3(ours, base, theirs)
+    assert result.clean, result.text
+    for kept in ("item 703", "item 813", "item 997"):  # the Doc's edits
+        assert kept in result.text
+    assert "text 0  \ntext 1  \n" in result.text  # local hard breaks survive
+
+
+def test_whitespace_retry_keeps_real_conflicts(merge3):
+    ours = "## Prep\n\n1. mine\n\n## Next\n"
+    base = "## Prep\n\n1. \n\n## Next\n"
+    theirs = "## Prep\n\n1. \n1. theirs\n\n## Next\n"
+    assert merge3(ours, base, theirs).conflicted
+
+
+def test_whitespace_only_local_change_small(merge3):
+    ours = "## Prep\n\n1.\n\n## Next\n\nx  \ny\n\nmine\n"
+    base = "## Prep\n\n1. \n\n## Next\n\nx\ny\n"
+    theirs = "## Prep\n\n1. \n1. added\n\n## Next\n\nx\ny\n"
+    result = merge3(ours, base, theirs)
+    assert result.clean, result.text
+    assert "1. added" in result.text
+    assert "x  \ny\n\nmine\n" in result.text  # local edits and an added hard break kept
