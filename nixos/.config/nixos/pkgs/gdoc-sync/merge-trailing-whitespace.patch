--- a/src/gdoc_sync/merge.py
+++ b/src/gdoc_sync/merge.py
@@ -162,16 +162,59 @@ def merge3(
     # exit 2). Retry with the numbers made uniform on all three sides, and use
     # that only when it actually removes every conflict; the list then keeps
     # the Doc's "1." style, which renders the same.
-    if any(_OL_RE.search(t) for t in (ours_n, base_n, theirs_n)):
-        retry = _merge_texts(
-            _uniform_list_numbers(ours_n), _uniform_list_numbers(base_n),
-            _uniform_list_numbers(theirs_n), *labels,
-        )
+    #
+    # Trailing whitespace is noise too (``normalize`` already ignores it for
+    # change detection): an editor save trims an empty item "1. " to "1.", and
+    # a Doc edit that grows that list then reads as both sides changing the
+    # same line (2026-11-13: a meeting note latched the pass at exit 2). Retry
+    # with each side's whitespace-only line changes undone, and with both
+    # fixes together, again keeping a retry only when it is clean.
+    numbered = any(_OL_RE.search(t) for t in (ours_n, base_n, theirs_n))
+    uniform_base = _uniform_list_numbers(base_n)
+    retries: list[tuple[str, str, str]] = []
+    if numbered:
+        retries.append((_uniform_list_numbers(ours_n), uniform_base,
+                        _uniform_list_numbers(theirs_n)))
+    retries.append((_snap_whitespace(ours_n, base_n), base_n,
+                    _snap_whitespace(theirs_n, base_n)))
+    if numbered:
+        retries.append((_snap_whitespace(_uniform_list_numbers(ours_n), uniform_base),
+                        uniform_base,
+                        _snap_whitespace(_uniform_list_numbers(theirs_n), uniform_base)))
+    for o, b, t in retries:
+        retry = _merge_texts(o, b, t, *labels)
         if not retry.conflicted:
             return retry
     return merged
 
 
+def _snap_whitespace(text: str, base: str) -> str:
+    """``text`` with each line that only *lost* trailing whitespace against
+    ``base`` put back to ``base``'s bytes, so the merge sees no edit there.
+
+    Lines are paired by a diff of their stripped forms. Only trims are undone
+    (an editor's "1. " → "1."); a line that gained whitespace, such as a new
+    markdown hard break ("two spaces"), is a real edit and is kept as is.
+    """
+    import difflib
+
+    t_lines = text.splitlines(keepends=True)
+    b_lines = base.splitlines(keepends=True)
+    sm = difflib.SequenceMatcher(
+        None, [line.rstrip() for line in b_lines],
+        [line.rstrip() for line in t_lines], autojunk=False,
+    )
+    out = list(t_lines)
+    for tag, i1, i2, j1, _j2 in sm.get_opcodes():
+        if tag != "equal":
+            continue
+        for k in range(i2 - i1):
+            b_line, t_line = b_lines[i1 + k], t_lines[j1 + k]
+            if len(t_line.rstrip("\n")) < len(b_line.rstrip("\n")):
+                out[j1 + k] = b_line
+    return "".join(out)
+
+
 # "  12. item" / "3) item" → number + delimiter, keeping indent and spacing.
 _OL_RE = re.compile(r"^([ \t]*)\d{1,9}([.)])(?=[ \t])", re.MULTILINE)
 
