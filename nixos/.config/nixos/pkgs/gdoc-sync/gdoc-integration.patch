+# --- gdoc-sync hook -------------------------------------------------------------
+
+def _payload(tool, path):
+    return json.dumps({"tool_name": tool, "tool_input": {"file_path": str(path)}})
+
+
+@pytest.fixture
+def hooked(tmp_path, monkeypatch):
+    md = tmp_path / "n.md"
+    md.write_text("x\n")
+    monkeypatch.setattr("gdoc_sync.config.get_doc_id",
+                        lambda p: "DOC" if str(p) == str(md.resolve()) else None)
+    monkeypatch.setattr("gdoc_sync.auth.get_credentials",
+                        lambda interactive=True: object())
+    calls = []
+
+    def fake_sync(files, **kw):
+        calls.append((files, kw))
+        print(json.dumps({"pushed": not kw["no_push"], "reload": kw["no_push"],
+                          "detail": "ok"}))
+
+    monkeypatch.setattr(cli, "_run_sync", fake_sync)
+    return md, calls
+
+
+def test_hook_pushes_after_a_write(hooked, capsys):
+    md, calls = hooked
+    assert hook_mod.run_hook(_payload("Edit", md)) == 0
+    assert calls[0][1]["no_push"] is False
+    assert "n.md: ok" in capsys.readouterr().err
+
+
+def test_hook_only_pulls_before_a_read(hooked):
+    md, calls = hooked
+    assert hook_mod.run_hook(_payload("Read", md)) == 0
+    assert calls[0][1]["no_push"] is True
+
