+            "WARN: gdoc auto-update timed out; continuing with current version",
+            file=sys.stderr,
+        )
+        return
+    except Exception:
+        print(
+            "WARN: gdoc auto-update failed; continuing with current version",
+            file=sys.stderr,
+        )
+        return
