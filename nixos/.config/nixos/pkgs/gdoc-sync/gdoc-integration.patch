+def test_new_comment_is_anchored_without_a_drive_comment():
+    md = "The quick brown fox.{>>comment: source?<<}\n"
+    drive = FakeDrive()
+    docs = FakeDocs(_doc("The quick brown fox."), reply=ANCHORED)
+    result = comments_mod.apply_new_comments(drive, docs, "D", md)
+    assert result.lines == ["New anchored comment: source?"]
+    assert drive.writes == []
+    assert comments_mod.consume_action_markers(md, result.applied) == \
+        "The quick brown fox.\n"
