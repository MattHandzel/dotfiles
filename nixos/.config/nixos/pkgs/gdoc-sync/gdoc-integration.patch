+def anchor_comment(docs_service, doc_id: str, text: str, quote: str) -> str:
+    """Create a comment anchored to ``quote`` in the doc; its ID, or "".
+
+    Uses the Docs API ``insertComment`` request, the approach and text search
+    of gdoc's ``comment --quote`` (vendored in ``gdoc_sync._gdoc``). Google
+    offers that request only to OAuth projects enrolled in the Workspace
+    Developer Preview Program; for anyone else, and when the quote is not in
+    the doc, this returns "" and the caller falls back to a Drive comment.
+    """
+    from googleapiclient.errors import HttpError
