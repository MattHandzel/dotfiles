new file mode 100755
index 0000000..48df7d0
--- /dev/null
+++ b/scripts/vendor-gdoc.sh
@@ -0,0 +1,105 @@
+#!/usr/bin/env bash
+# Re-vendor LucaDeLeo/gdoc (MIT) into src/gdoc_sync/_gdoc and its tests into
+# tests/gdoc_upstream, rewriting `gdoc.` imports to `gdoc_sync._gdoc.` and
+# applying the local patches in scripts/vendor-gdoc-patches/ in order.
+#
+#   scripts/vendor-gdoc.sh [REF]        # default: main
+#
+# Run the test suite afterwards; a patch that no longer applies stops the
+# script so it can be re-cut against the new upstream.
+set -euo pipefail
+
+REF="${1:-main}"
+REPO_URL="https://github.com/LucaDeLeo/gdoc"
+ROOT="$(cd "$(dirname "$0")/.." && pwd)"
+PKG="$ROOT/src/gdoc_sync/_gdoc"
+TESTS="$ROOT/tests/gdoc_upstream"
+PATCHES="$ROOT/scripts/vendor-gdoc-patches"
+
+work="$(mktemp -d)"
+trap 'rm -rf "$work"' EXIT
+
+git clone --quiet "$REPO_URL" "$work/gdoc"
+git -C "$work/gdoc" checkout --quiet "$REF"
+sha="$(git -C "$work/gdoc" rev-parse HEAD)"
+version="$(sed -n 's/^__version__ = "\(.*\)"/\1/p' "$work/gdoc/gdoc/__init__.py")"
+
+rm -rf "$PKG" "$TESTS"
+cp -R "$work/gdoc/gdoc" "$PKG"
+cp -R "$work/gdoc/tests" "$TESTS"
+find "$PKG" "$TESTS" -name __pycache__ -type d -prune -exec rm -rf {} +
+touch "$TESTS/__init__.py"
+
+# Every top-level module/package name inside gdoc/, so string patch targets
+# like "gdoc.api.drive.get_file_version" are rewritten but "gdoc.md" is not.
+mods="$(cd "$PKG" && ls | sed -n 's/\.py$//p; /^[a-z_]*$/p' | sort -u | paste -sd'|' -)"
+
+python3 - "$PKG" "$TESTS" "$mods" <<'PY'
+import pathlib, re, sys
+pkg, tests, mods = pathlib.Path(sys.argv[1]), pathlib.Path(sys.argv[2]), sys.argv[3]
+rules = [
+    (re.compile(r"^(\s*)from gdoc(\.| import)", re.M), r"\1from gdoc_sync._gdoc\2"),
+    (re.compile(r"^(\s*)import gdoc\.", re.M), r"\1import gdoc_sync._gdoc."),
+    (re.compile(r"^(\s*)import gdoc$", re.M), r"\1import gdoc_sync._gdoc as gdoc"),
+    (re.compile(r"""(["'])gdoc\.(%s)\b""" % mods), r"\1gdoc_sync._gdoc.\2"),
+    (re.compile(r"^(\s*)from tests\.conftest import", re.M),
+     r"\1from tests.gdoc_upstream.conftest import"),
+    # subprocess tests run `python -m gdoc`
+    (re.compile(r"""(["'])-m\1,\s*(["'])gdoc\2"""), r'"-m", "gdoc_sync._gdoc"'),
+]
+for root in (pkg, tests):
+    for path in root.rglob("*.py"):
+        text = path.read_text()
+        new = text
+        for pat, repl in rules:
+            new = pat.sub(repl, new)
+        if new != text:
+            path.write_text(new)
+PY
+
+if [ -d "$PATCHES" ]; then
+  for p in "$PATCHES"/*.patch; do
+    [ -e "$p" ] || continue
+    patch -p1 --quiet --no-backup-if-mismatch -d "$ROOT" < "$p" \
+      || { echo "vendor-gdoc: $p no longer applies; re-cut it" >&2; exit 1; }
+  done
+fi
+
+cat > "$PKG/UPSTREAM.md" <<EOF
+# Vendored: LucaDeLeo/gdoc
+
+- Source: $REPO_URL
+- Commit: \`$sha\` (gdoc $version)
+- License: MIT (see LICENSE in this directory)
+
+Do not edit these files by hand. Imports were rewritten from \`gdoc.\` to
+\`gdoc_sync._gdoc.\` by \`scripts/vendor-gdoc.sh\`, which also applies
+\`scripts/vendor-gdoc-patches/*.patch\`. gdoc-sync wires this package to its
+own credentials and config directory in \`src/gdoc_sync/gdoc_bridge.py\`.
+EOF
+
+cat > "$PKG/LICENSE" <<'EOF'
+MIT License
+
+Copyright (c) 2026 the gdoc authors (https://github.com/LucaDeLeo/gdoc)
+
+Permission is hereby granted, free of charge, to any person obtaining a copy
+of this software and associated documentation files (the "Software"), to deal
+in the Software without restriction, including without limitation the rights
+to use, copy, modify, merge, publish, distribute, sublicense, and/or sell
+copies of the Software, and to permit persons to whom the Software is
+furnished to do so, subject to the following conditions:
+
+The above copyright notice and this permission notice shall be included in all
+copies or substantial portions of the Software.
+
+THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
+IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
+FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
+AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
+LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
+OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE
+SOFTWARE.
+EOF
+
+echo "vendored gdoc $version ($sha)"
