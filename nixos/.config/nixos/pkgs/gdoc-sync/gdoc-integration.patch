+++ b/src/gdoc_sync/hook.py
@@ -0,0 +1,98 @@
+"""`gdoc-sync hook`: keep linked files in sync around a Claude Code agent's edits.
+
+Wire it as a Claude Code hook (settings.json)::
+
+    "PreToolUse":  [{"matcher": "Read",
+                     "hooks": [{"type": "command", "command": "gdoc-sync hook"}]}],
+    "PostToolUse": [{"matcher": "Write|Edit|MultiEdit",
+                     "hooks": [{"type": "command", "command": "gdoc-sync hook"}]}]
+
+Before a Read, the doc's edits are merged into the file (nothing is pushed),
+so the agent reads what collaborators wrote. After a Write or Edit, the file
+gets one normal two-way sync, so the agent's edit reaches the doc. Files that
+are not linked, not markdown, or marked pull-only are left alone (a pull-only
+file still pulls before a Read). The idea and the hook shape come from gdoc's
+``_sync-hook``/``_pull-hook``; the reconcile is gdoc-sync's merge engine, so a
+collaborator's concurrent edit is merged instead of overwritten.
+
+Exit codes follow Claude Code's contract: 0 for done or nothing to do; 2 when
+the file is in conflict, with the reason on stderr, which Claude Code shows to
+the agent; 1 for any other failure, shown to the user only. The hook never
+opens a browser: with no usable login it says so and exits 1.
+"""
+
+from __future__ import annotations
+
+import contextlib
+import io
+import json
+import sys
+from pathlib import Path
+
+_READ_TOOLS = {"Read"}
+_WRITE_TOOLS = {"Write", "Edit", "MultiEdit"}
+
+
+def _target(payload: dict) -> tuple[Path | None, bool]:
+    """(linked markdown file, is_write) from a hook payload, or (None, _)."""
+    tool = payload.get("tool_name", "")
+    if tool not in _READ_TOOLS | _WRITE_TOOLS:
+        return None, False
+    raw = (payload.get("tool_input") or {}).get("file_path") or ""
+    if not raw.endswith(".md"):
+        return None, False
+    path = Path(raw).expanduser()
+    if not path.is_absolute():
+        path = Path(payload.get("cwd") or ".") / path
+    if not path.is_file():
+        return None, False
+    return path.resolve(), tool in _WRITE_TOOLS
+
+
+def run_hook(stdin: str) -> int:
+    try:
+        payload = json.loads(stdin) if stdin.strip() else {}
+    except json.JSONDecodeError:
+        return 0
+    path, is_write = _target(payload)
+    if path is None:
+        return 0
+
+    from .config import get_doc_id
+    if not get_doc_id(str(path)):
+        return 0
+
+    from .auth import get_credentials
+    try:
+        get_credentials(interactive=False)
+    except Exception as e:  # no token, dead token, no client secret
+        print(f"gdoc-sync hook: {path.name} not synced: {e}".splitlines()[0],
+              file=sys.stderr)
+        return 1
+
+    from .cli import _run_sync
+    out = io.StringIO()
+    try:
+        with contextlib.redirect_stdout(out):
+            _run_sync([path], adopt=None, no_push=not is_write, force=False,
+                      json_lines=True)
+    except SystemExit as e:
+        if e.code == 2:
+            print(f"gdoc-sync: {path.name} is in conflict with its Google Doc and "
+                  f"was not synced. Run `gdoc-sync diff {path}` and resolve it "
+                  f"(see `gdoc-sync resolve --help`).", file=sys.stderr)
+            return 2
+        return int(e.code or 0)
+    except Exception as e:
+        print(f"gdoc-sync hook: syncing {path.name} failed: {e}", file=sys.stderr)
+        return 1
+
+    for line in out.getvalue().splitlines():
+        try:
+            event = json.loads(line)
+        except json.JSONDecodeError:
+            continue
+        if event.get("pushed") or event.get("reload"):
+            print(f"gdoc-sync: {path.name}: {event.get('detail', '')}",
+                  file=sys.stderr)
+    return 0
