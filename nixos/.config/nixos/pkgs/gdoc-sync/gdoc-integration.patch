+"""gdoc-sync's use of the vendored gdoc: CLI routing, credentials, linked-file
+arguments, anchored ``{>>comment:<<}`` markers, and the Claude Code hook."""
+
+from __future__ import annotations
+
+import json
+import os
+
+import pytest
+
+from gdoc_sync import cli, gdoc_bridge
+from gdoc_sync import comments as comments_mod
+from gdoc_sync import hook as hook_mod
+from tests.test_comments import FakeDrive, _http_error
+
+
+@pytest.fixture(autouse=True)
+def isolated(tmp_path, monkeypatch):
+    """Keep install()'s env writes and credential patch inside the test."""
+    monkeypatch.setenv("XDG_CONFIG_HOME", str(tmp_path / "config"))
+    monkeypatch.setenv("XDG_STATE_HOME", str(tmp_path / "state"))
+    monkeypatch.delenv("GDOC_SYNC_CONFIG", raising=False)
+    for var in ("GDOC_CONFIG_DIR", "GDOC_PROG", "GDOC_AUTO_UPDATE",
+                "GDOC_SKIP_UPDATE_CHECK", "GDOC_CLIENT_CREDENTIALS",
+                "GDOC_CLIENT_ID"):
+        monkeypatch.setenv(var, "")
+        monkeypatch.delenv(var)
+    from gdoc_sync._gdoc import auth as gauth
+    monkeypatch.setattr(gauth, "get_credentials", gauth.get_credentials)
+    monkeypatch.setattr(gdoc_bridge, "_installed", False)
+
+
+# --- CLI routing --------------------------------------------------------------
+
+def test_top_level_command_list_matches_vendored_gdoc():
+    assert set(cli.DOC_COMMANDS) == set(gdoc_bridge.top_level_commands())
+
+
+def test_shadowed_names_are_exactly_the_shared_ones():
+    import argparse
+    sync_parser = cli.build_parser()
+    sub = next(a for a in sync_parser._actions
+               if isinstance(a, argparse._SubParsersAction))
+    shared = set(sub.choices) & set(gdoc_bridge.commands())
+    assert shared == set(gdoc_bridge.SHADOWED)
+
+
+@pytest.mark.parametrize("argv, forwarded", [
+    (["cat", "DOC"], ["cat", "DOC"]),
+    (["doc", "pull", "DOC", "x.md"], ["pull", "DOC", "x.md"]),
+    (["--config", "CFG", "suggest", "DOC", "a", "b"], ["suggest", "DOC", "a", "b"]),
+    (["diff", "DOC", "--rev", "prev"], ["diff", "DOC", "--rev", "prev"]),
+    (["auth", "--account", "work"], ["auth", "--account", "work"]),
+])
+def test_main_forwards_gdoc_commands(argv, forwarded, monkeypatch, tmp_path):
+    cfg = tmp_path / "c.yaml"
+    cfg.write_text("{}\n")
+    argv = [str(cfg) if a == "CFG" else a for a in argv]
+    seen = []
+    monkeypatch.setattr(gdoc_bridge, "run", lambda a: seen.append(a) or 0)
+    with pytest.raises(SystemExit) as e:
+        cli.main(argv)
+    assert e.value.code == 0
+    assert seen == [forwarded]
+
+
+def test_main_keeps_gdoc_syncs_own_shared_commands(monkeypatch, tmp_path):
+    md = tmp_path / "n.md"
+    md.write_text("x\n")
+    monkeypatch.setattr(gdoc_bridge, "run",
+                        lambda a: pytest.fail("forwarded to gdoc"))
+    called = []
+    monkeypatch.setattr(cli, "_dispatch", lambda args: called.append(args.command))
+    cli.main(["diff", str(md)])
+    assert called == ["diff"]
+
+
+def test_update_and_default_auth_are_refused(capsys):
+    assert gdoc_bridge.run(["update"]) == 3
+    assert "update gdoc-sync" in capsys.readouterr().err
+    assert gdoc_bridge.run(["auth"]) == 3
+    assert "gdoc-sync auth" in capsys.readouterr().err
+
+
+# --- install(): config dir, no self-update, credentials ----------------------
+
+def test_install_points_gdoc_at_gdoc_syncs_config(tmp_path):
+    gdoc_bridge.install()
+    assert os.environ["GDOC_CONFIG_DIR"] == str(tmp_path / "config" / "gdoc-sync" / "gdoc")
+    assert os.environ["GDOC_AUTO_UPDATE"] == "0"
+    assert os.environ["GDOC_SKIP_UPDATE_CHECK"] == "1"
+    assert os.environ["GDOC_PROG"] == "gdoc-sync doc"
+
+
+def test_install_offers_gdoc_syncs_oauth_client(tmp_path):
+    cs = tmp_path / "config" / "gdoc-sync" / "client_secret.json"
+    cs.parent.mkdir(parents=True)
+    cs.write_text("{}")
+    gdoc_bridge.install()
+    assert os.environ["GDOC_CLIENT_CREDENTIALS"] == str(cs)
+
+
+def test_default_account_uses_gdoc_syncs_token(monkeypatch):
+    from gdoc_sync import auth as sync_auth
+    from gdoc_sync._gdoc import auth as gauth
+    sentinel = object()
+    monkeypatch.setattr(sync_auth, "get_credentials",
+                        lambda interactive=True: sentinel)
+    monkeypatch.setattr("gdoc_sync._gdoc.util.resolve_account", lambda: None)
+    gdoc_bridge.install()
+    assert gauth.get_credentials() is sentinel
+
+
+def test_named_account_keeps_gdocs_own_token(monkeypatch):
+    from gdoc_sync._gdoc import auth as gauth
+    calls = []
+    monkeypatch.setattr(gauth, "get_credentials",
+                        lambda account=gauth._RESOLVE: calls.append(account) or "named")
+    monkeypatch.setattr("gdoc_sync._gdoc.util.resolve_account", lambda: "work")
+    gdoc_bridge.install()
+    assert gauth.get_credentials() == "named"
+    assert calls == ["work"]
+
+
+def test_missing_login_is_a_gdoc_auth_error(monkeypatch):
+    from gdoc_sync import auth as sync_auth
+    from gdoc_sync._gdoc import auth as gauth
+    from gdoc_sync._gdoc.util import AuthError
+
+    def dead(interactive=True):
+        raise RuntimeError("no usable token — run: gdoc-sync auth")
+
+    monkeypatch.setattr(sync_auth, "get_credentials", dead)
+    monkeypatch.setattr("gdoc_sync._gdoc.util.resolve_account", lambda: None)
+    gdoc_bridge.install()
+    with pytest.raises(AuthError, match="gdoc-sync auth"):
+        gauth.get_credentials()
