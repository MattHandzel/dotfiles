+def _doc(text, tab_id="t.0", revision="rev-9"):
+    body = {"content": [{"startIndex": 1, "endIndex": 1 + len(text) + 1,
+                         "paragraph": {"elements": [{
+                             "startIndex": 1, "endIndex": 1 + len(text) + 1,
+                             "textRun": {"content": text + "\n"}}]}}]}
+    return {"revisionId": revision,
+            "tabs": [{"tabProperties": {"tabId": tab_id, "title": "Tab 1"},
+                      "documentTab": {"body": body}}]}
+
+
+class FakeDocs:
+    def __init__(self, document, reply=None, fail=False):
+        self.document, self.reply, self.fail = document, reply, fail
+        self.updates: list[dict] = []
+
+    def documents(self):
+        return self
+
+    def get(self, **_kw):
+        return _Run(lambda: self.document)
+
+    def batchUpdate(self, documentId, body):
+        def run():
+            self.updates.append(body)
+            if self.fail:
+                raise _http_error()
+            return self.reply
+        return _Run(run)
+
+
+class _Run:
+    def __init__(self, fn):
+        self.fn = fn
+
+    def execute(self, **_kw):
+        return self.fn()
+
+
+ANCHORED = {"replies": [{"insertComment": {"commentThread": {"commentId": "c-1"}}}]}
+
+
+def test_anchor_comment_targets_the_quoted_range():
+    docs = FakeDocs(_doc("The quick brown fox."), reply=ANCHORED)
+    assert comments_mod.anchor_comment(docs, "D", "hi", "brown fox") == "c-1"
+    (body,) = docs.updates
+    req = body["requests"][0]["insertComment"]
+    assert req == {"content": "hi",
+                   "range": {"startIndex": 11, "endIndex": 20, "tabId": "t.0"}}
+    assert body["writeControl"] == {"requiredRevisionId": "rev-9"}
+
+
+def test_anchor_comment_falls_back_when_google_refuses():
+    docs = FakeDocs(_doc("The quick brown fox."), fail=True)
+    assert comments_mod.anchor_comment(docs, "D", "hi", "brown fox") == ""
+
+
+def test_anchor_comment_falls_back_when_the_quote_is_missing():
+    docs = FakeDocs(_doc("Something else."), reply=ANCHORED)
+    assert comments_mod.anchor_comment(docs, "D", "hi", "brown fox") == ""
+    assert docs.updates == []
+
