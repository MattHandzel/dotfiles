+def markdown_to_quote(line: str) -> str:
+    """Plain text of one markdown line, as it reads in the doc.
+
+    ``- **Bold** [link](https://x)`` → ``Bold link``. Used to find the line a
+    ``{>>comment:<<}`` follows in the doc so the comment can anchor to it.
+    """
+    text = _MD_LINK_RE.sub(r"\1", line)
+    text = _MD_PREFIX_RE.sub("", text)
+    text = _MD_EMPHASIS_RE.sub("", text)
