+    except Exception:
+        return
+
+    print(f"Updating gdoc: {current} → {latest}...", file=sys.stderr)
+    try:
+        result = subprocess.run(
+            ["uv", "tool", "install", "--force",
+             f"git+https://github.com/{_GITHUB_REPO}.git"],
+            capture_output=True,
+            timeout=_UV_INSTALL_TIMEOUT_SECONDS,
+        )
