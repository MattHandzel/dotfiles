index 0000000..fd2912d
--- /dev/null
+++ b/src/gdoc_sync/gdoc_bridge.py
@@ -0,0 +1,176 @@
+"""Run the vendored gdoc CLI (``gdoc_sync._gdoc``) inside gdoc-sync.
+
+gdoc (https://github.com/LucaDeLeo/gdoc, MIT) is a command-per-action
+Google Docs/Drive/Sheets CLI built for agents: targeted edits, suggested
+edits, anchored comments, revisions, tabs, images, Sheets, an MCP server.
+gdoc-sync vendors it and exposes it as ``gdoc-sync doc <command>``, and
+every gdoc command whose name gdoc-sync does not already use also works at
+the top level (``gdoc-sync cat notes.md``).
+
+What this module changes about gdoc when it runs here:
+
+* Credentials: the default account is gdoc-sync's own token, so nothing
+  needs a second ``auth``. Named accounts (``--account work``) still use
+  gdoc's per-account tokens, stored under gdoc-sync's config directory and
+  authorized with gdoc-sync's OAuth client.
+* Config: gdoc's state (read baselines, accounts) lives in
+  ``<gdoc-sync config dir>/gdoc``, not ``~/.config/gdoc``.
+* No self-updates: gdoc updates with gdoc-sync (``scripts/vendor-gdoc.sh``).
+* Linked files: a markdown file linked with gdoc-sync can stand in for its
+  doc ID or URL (``gdoc-sync suggest notes.md "old" "new"``).
+"""
+
+from __future__ import annotations
+
+import os
+import sys
+from pathlib import Path
+
+# gdoc subcommands that gdoc-sync also defines. Top-level ``gdoc-sync <name>``
+# keeps gdoc-sync's meaning; gdoc's version is ``gdoc-sync doc <name>``.
+SHADOWED = frozenset({
+    "auth", "config", "diff", "export", "pull", "push", "resolve", "share",
+})
+
+# gdoc commands not offered: self-update (gdoc ships inside gdoc-sync) and the
+# hooks for gdoc's own frontmatter-stamped files (gdoc-sync has `hook`).
+HIDDEN = frozenset({"update", "_sync-hook", "_pull-hook"})
+
+# Options whose value is a local file, never a doc reference.
+_FILE_OPTIONS = frozenset({
+    "--old-file", "--new-file", "--file", "--out", "--download", "-o",
+})
+
+
+def _setup_env() -> None:
+    """Point gdoc at gdoc-sync's config before any gdoc module is imported."""
+    from .auth import client_secret_path
+    from .config import config_dir
+
+    os.environ.setdefault("GDOC_CONFIG_DIR", str(config_dir() / "gdoc"))
+    os.environ.setdefault("GDOC_PROG", "gdoc-sync doc")
+    os.environ["GDOC_AUTO_UPDATE"] = "0"
+    os.environ["GDOC_SKIP_UPDATE_CHECK"] = "1"
+    # `doc auth --account X` authorizes with the OAuth client gdoc-sync
+    # already has, unless the caller chose a different one.
+    if not any(os.environ.get(v) for v in
+               ("GDOC_CLIENT_ID", "GDOC_CLIENT_CREDENTIALS")):
+        cs = client_secret_path()
+        if cs.exists():
+            os.environ["GDOC_CLIENT_CREDENTIALS"] = str(cs)
+
+
+_installed = False
+
+
+def install() -> None:
+    """Wire the vendored gdoc to gdoc-sync's credentials (idempotent)."""
+    global _installed
+    if _installed:
+        return
+    _setup_env()
+
+    from ._gdoc import auth as gauth
+    from ._gdoc.util import AuthError, GdocError, resolve_account
+
+    original = gauth.get_credentials
+    sentinel = gauth._RESOLVE
+
+    def get_credentials(account=sentinel):
+        resolved = resolve_account() if account is sentinel else account
+        if resolved:
+            return original(resolved)
+        from google.auth.exceptions import TransportError
+
+        from .auth import get_credentials as sync_credentials
+        try:
+            return sync_credentials(interactive=False)
+        except TransportError as e:
+            raise GdocError(
+                f"network error while refreshing credentials ({e}); "
+                "check the connection and try again") from None
+        except (RuntimeError, FileNotFoundError) as e:
+            raise AuthError(f"{e}".splitlines()[0] + " (run: gdoc-sync auth)") from None
+
+    gauth.get_credentials = get_credentials
+    _installed = True
+
+
+def resolve_linked_files(argv: list[str]) -> list[str]:
+    """Replace the first linked markdown path in ``argv`` with its doc ID.
+
+    Only the first one: in ``write notes.md notes.md`` the second path is the
+    content to upload. Values of file-taking options are never replaced.
+    """
+    from .config import get_doc_id
+
+    out = list(argv)
+    for i, arg in enumerate(out):
+        if arg.startswith("-") or (i and out[i - 1] in _FILE_OPTIONS):
+            continue
+        path = Path(arg).expanduser()
+        if not path.is_file():
+            continue
+        doc_id = get_doc_id(str(path.resolve()))
+        if doc_id:
+            out[i] = doc_id
+            break
+    return out
+
+
+def commands() -> list[str]:
+    """Every gdoc subcommand gdoc-sync offers under ``doc``."""
+    import argparse
+
+    install()
+    from ._gdoc.cli import build_parser
+
+    parser = build_parser()
+    for action in parser._actions:
+        if isinstance(action, argparse._SubParsersAction):
+            return sorted(c for c in action.choices if c not in HIDDEN)
+    return []
+
+
+def top_level_commands() -> list[str]:
+    """gdoc subcommands reachable as ``gdoc-sync <command>``."""
+    return [c for c in commands() if c not in SHADOWED]
+
+
+def parses(argv: list[str]) -> bool:
+    """Whether gdoc's own parser accepts ``argv`` (linked files resolved)."""
+    import contextlib
+    import io
+
+    install()
+    from ._gdoc.cli import build_parser
+    try:
+        with contextlib.redirect_stderr(io.StringIO()), \
+                contextlib.redirect_stdout(io.StringIO()):
+            build_parser().parse_args(resolve_linked_files(argv))
+    except SystemExit:
+        return False
+    return True
+
+
+def run(argv: list[str]) -> int:
+    """Run ``gdoc <argv>`` with gdoc-sync's wiring; returns the exit code."""
+    install()
+    command = next((a for a in argv if not a.startswith("-")), None)
+    if command in HIDDEN:
+        if command == "update":
+            print("gdoc is vendored in gdoc-sync; update gdoc-sync instead.",
+                  file=sys.stderr)
+        else:
+            print(f"`{command}` is not available in gdoc-sync; "
+                  "see `gdoc-sync hook --help`.", file=sys.stderr)
+        return 3
+    if command == "auth" and "--account" not in argv and not any(
+            a.startswith("--account=") or a == "--set-default" for a in argv):
+        print("The default account is gdoc-sync's own login: run `gdoc-sync auth`.\n"
+              "`gdoc-sync doc auth --account NAME` adds another Google account.",
+              file=sys.stderr)
+        return 3
+
+    from ._gdoc.cli import run_argv
+    return run_argv(resolve_linked_files(argv), check_updates=False)
