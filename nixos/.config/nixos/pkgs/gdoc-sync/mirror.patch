+def _split_header(local: str, base_remote: str) -> tuple[str, str]:
+    """Split off the file's YAML frontmatter when the doc side has none.
+
+    A doc has nowhere to store frontmatter, so in a three-way merge the header
+    reads as a local insertion at line 0 — and every remote edit above the
+    doc's old first line inserts at that same spot and conflicts. Every
+    `import`ed file carries such a header. Returned as (header, body) with the
+    blank lines after the closing ``---`` kept in the header, so
+    ``header + body == local``. A base that has a header of its own (a doc
+    whose first line renders as ``---``) is merged whole, as before.
+    """
+    if not local.startswith("---\n") or base_remote.startswith("---\n"):
+        return "", local
+    end = local.find("\n---\n", 4)
+    if end == -1:
+        return "", local
+    end += len("\n---\n")
+    while local.startswith("\n", end):
+        end += 1
+    return local[:end], local[end:]
+
