+# ---------------------------------------------------------------------------
+# Local-only frontmatter (every `import`ed and mirrored file has one)
+# ---------------------------------------------------------------------------
+
+HEADER = "---\ntitle: Plan\ngdoc_id: doc-id\n---\n\n"
+
+
+def test_remote_edit_at_the_top_merges_under_local_frontmatter(tmp_path):
+    """The doc cannot hold the header, so it is not part of the merge.
+
+    Merged as body text it was a local insertion at line 0, and any remote
+    edit above the doc's old first line collided with it (found by mirroring
+    a real doc, 2026-10-06).
+    """
+    path, doc = linked(tmp_path, HEADER + "first line\n", doc_text="first line\n")
+    doc.edit("new top line\nfirst line\n")
+
+    result = run(path, doc, allow_push=False)
+
+    assert not result.conflicted
+    assert path.read_text() == HEADER + "new top line\nfirst line\n"
+
+
+def test_local_frontmatter_edit_and_remote_top_edit_both_survive(tmp_path):
+    path, doc = linked(tmp_path, HEADER + "first line\n", doc_text="first line\n")
+    path.write_text(HEADER.replace("Plan", "Plan v2") + "first line\n")
+    doc.edit("new top line\nfirst line\n")
+
+    result = run(path, doc, allow_push=False)
+
+    assert not result.conflicted
+    assert path.read_text() == HEADER.replace("Plan", "Plan v2") + "new top line\nfirst line\n"
