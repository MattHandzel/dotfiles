index 0000000..9857bc4
--- /dev/null
+++ b/tests/test_mirror.py
@@ -0,0 +1,233 @@
+"""`gdoc-sync mirror`: every doc in the account as a pull-only file, cheaply."""
+
+import argparse
+import datetime
+
+import pytest
+
+from gdoc_sync import cli, config, importer, mirror
+from gdoc_sync.pull import RenderedDoc
+
+
+@pytest.fixture(autouse=True)
+def isolated_env(tmp_path, monkeypatch):
+    monkeypatch.setenv("XDG_CONFIG_HOME", str(tmp_path / "config"))
+    monkeypatch.setenv("XDG_STATE_HOME", str(tmp_path / "state"))
+    monkeypatch.delenv("GDOC_SYNC_CONFIG", raising=False)
+    config.set_config_override(None)
+    yield
+    config.set_config_override(None)
+
+
+OLD = "2026-01-01T00:00:00.000Z"
+
+
+def doc(doc_id, name, *, modified="2026-09-01T00:00:00.000Z", created=OLD,
+        owned=True, viewed=None):
+    return {"id": doc_id, "name": name, "modifiedTime": modified,
+            "createdTime": created, "ownedByMe": owned, "viewedByMeTime": viewed}
+
+
+class FakeDrive:
+    """files().list(...).execute() over fixed pages, counting the calls."""
+
+    def __init__(self, *pages):
+        self.pages = [list(p) for p in pages]
+        self.calls = 0
+
+    def files(self):
+        return self
+
+    def list(self, **kwargs):
+        self.kwargs = kwargs
+        page = int(kwargs.get("pageToken") or 0)
+        drive = self
+
+        class Req:
+            def execute(self, num_retries=0):
+                drive.calls += 1
+                out = {"files": drive.pages[page]}
+                if page + 1 < len(drive.pages):
+                    out["nextPageToken"] = str(page + 1)
+                return out
+        return Req()
+
+
+@pytest.fixture
+def renders(monkeypatch):
+    """Stub every Google call behind import and refresh; record what rendered."""
+    bodies = {}
+    rendered = []
+
+    def render(doc_id, **_kwargs):
+        rendered.append(doc_id)
+        return RenderedDoc(markdown=bodies.get(doc_id, f"# {doc_id}\n"),
+                           revision_id="rev", title=doc_id, tabs=1, comments=0,
+                           images=0, fingerprint=bodies.get(doc_id, doc_id))
+
+    monkeypatch.setattr(importer, "fetch_title", lambda doc_id: doc_id)
+    monkeypatch.setattr(importer, "render_doc", render)
+    monkeypatch.setattr(mirror, "render_doc", render)
+    return bodies, rendered
+
+
+def run(dest, drive, **kw):
+    return mirror.mirror(dest, drive=drive, say=lambda *_: None, **kw)
+
+
+# --- listing ---------------------------------------------------------------
+
+def test_lists_owned_or_opened_docs_newest_first_across_pages():
+    drive = FakeDrive(
+        [doc("a", "A", modified="2026-01-01T00:00:00Z"),
+         doc("never-opened", "N", owned=False, viewed=None)],
+        [doc("b", "B", modified="2026-02-01T00:00:00Z", owned=False,
+             viewed="2026-10-01T00:00:00Z")],
+    )
+    assert [d["id"] for d in mirror.list_docs(drive)] == ["b", "a"]
+    assert drive.calls == 2
+    assert "trashed=false" in drive.kwargs["q"]
+
+
+# --- importing -------------------------------------------------------------
+
+def test_imports_unlinked_docs_as_pull_only(tmp_path, renders):
+    dest = tmp_path / "mirror"
+    report = run(dest, FakeDrive([doc("DOC1", "Weekly Plan")]))
+
+    path = (dest / "weekly-plan.md").resolve()
+    assert report.imported == [str(path)]
+    assert path.read_text().startswith("---\n")
+    assert config.get_doc_id(path) == "DOC1"
+    assert config.is_pull_only(path)
+    assert str(path) in mirror.mirrored_paths()
+
+
+def test_skips_docs_the_user_already_linked(tmp_path, renders):
+    note = tmp_path / "my-note.md"
+    note.write_text("x")
+    config.set_doc_id(note, "DOC1")
+
+    report = run(tmp_path / "mirror", FakeDrive([doc("DOC1", "Weekly Plan")]))
+    assert report.imported == []
+    assert not (tmp_path / "mirror").exists()
+
+
+def test_brand_new_doc_waits_for_its_mapping(tmp_path, renders):
+    """`create` saves its mapping a moment after the doc exists in Drive."""
+    just_now = datetime.datetime.now(datetime.timezone.utc).isoformat()
+    report = run(tmp_path / "m", FakeDrive([doc("NEW", "Fresh", created=just_now)]))
+    assert report.imported == []
+
+
+def test_same_title_gets_an_id_suffix_instead_of_overwriting(tmp_path, renders):
+    dest = tmp_path / "m"
+    dest.mkdir()
+    (dest / "untitled-document.md").write_text("someone else's file\n")
+
+    report = run(dest, FakeDrive([doc("AAAAAAAAAA1", "Untitled document"),
+                                  doc("BBBBBBBBBB2", "Untitled document")]))
+
+    names = sorted(p.split("/")[-1] for p in report.imported)
+    assert names == ["untitled-document-AAAAAAAA.md", "untitled-document-BBBBBBBB.md"]
+    assert (dest / "untitled-document.md").read_text() == "someone else's file\n"
+
+
+def test_limit_caps_imports_per_pass(tmp_path, renders):
+    drive = FakeDrive([doc(f"D{i}", f"Doc {i}") for i in range(5)])
+    first = run(tmp_path / "m", drive, limit=2)
+    assert len(first.imported) == 2 and first.pending == 3
+    second = run(tmp_path / "m", drive, limit=10)
+    assert len(second.imported) == 3 and second.pending == 0
+
+
+def test_dry_run_writes_nothing(tmp_path, renders):
+    report = run(tmp_path / "m", FakeDrive([doc("DOC1", "Plan")]), dry_run=True)
+    assert len(report.imported) == 1
+    assert not (tmp_path / "m").exists()
+    assert config.load_state() == {}
+
+
+def test_failed_import_is_not_retried_every_pass(tmp_path, monkeypatch, renders):
+    def boom(*_a, **_k):
+        raise RuntimeError("403 no access")
+    monkeypatch.setattr(importer, "render_doc", boom)
+    drive = FakeDrive([doc("DOC1", "Locked")])
+
+    assert run(tmp_path / "m", drive).failed == ["Locked"]
+    assert run(tmp_path / "m", drive).failed == []  # within the retry window
+    assert "403" in config.load_state()["mirrored"]["DOC1"]["error"]
+
+
+# --- keeping mirrored files current ----------------------------------------
+
+def test_idle_pass_renders_nothing(tmp_path, renders):
+    _, rendered = renders
+    drive = FakeDrive([doc("DOC1", "Plan")])
+    run(tmp_path / "m", drive)
+    rendered.clear()
+
+    report = run(tmp_path / "m", drive)
+    assert rendered == [] and report.refreshed == [] and report.imported == []
+
+
+def test_changed_doc_is_pulled_again(tmp_path, renders):
+    bodies, _ = renders
+    bodies["DOC1"] = "# Plan\n\nold\n"
+    run(tmp_path / "m", FakeDrive([doc("DOC1", "Plan", modified="2026-09-01T00:00:00Z")]))
+
+    bodies["DOC1"] = "# Plan\n\nnew\n"
+    report = run(tmp_path / "m",
+                 FakeDrive([doc("DOC1", "Plan", modified="2026-10-06T00:00:00Z")]))
+
+    path = (tmp_path / "m" / "plan.md").resolve()
+    assert report.refreshed == [str(path)]
+    assert path.read_text().rstrip().endswith("new")
+    assert config.load_state()["mirrored"]["DOC1"]["modified"] == "2026-10-06T00:00:00Z"
+
+
+def test_deleted_mirror_file_is_not_brought_back(tmp_path, renders):
+    drive = FakeDrive([doc("DOC1", "Plan")])
+    run(tmp_path / "m", drive)
+    (tmp_path / "m" / "plan.md").unlink()
+
+    report = run(tmp_path / "m", drive)
+    assert report.imported == [] and not (tmp_path / "m" / "plan.md").exists()
+
+
+# --- the rest of the CLI ---------------------------------------------------
+
+def test_sync_all_skips_mirrored_files(tmp_path, renders):
+    run(tmp_path / "m", FakeDrive([doc("DOC1", "Plan")]))
+    own = tmp_path / "own.md"
+    own.write_text("x")
+    config.set_doc_id(own, "DOC2")
+
+    targets = cli._sync_targets(argparse.Namespace(all=True, files=[]), "sync")
+    assert [p.resolve() for p in targets] == [own.resolve()]
+
+
+def test_import_of_an_already_linked_doc_returns_the_existing_file(tmp_path, monkeypatch):
+    note = tmp_path / "meeting.md"
+    note.write_text("x")
+    config.set_doc_id(note, "DOC1")
+
+    def no_api(*_a, **_k):
+        raise AssertionError("must not touch the API")
+    monkeypatch.setattr(importer, "fetch_title", no_api)
+
+    said = []
+    path = importer.import_doc("https://docs.google.com/document/d/DOC1/edit",
+                               dest=tmp_path / "elsewhere", say=said.append)
+    assert path.resolve() == note.resolve()
+    assert any("Already linked to" in s for s in said)
+    assert not (tmp_path / "elsewhere").exists()
+
+
+def test_overlapping_pass_is_skipped(tmp_path, renders):
+    """A tick that starts while a long first import runs must not import twice."""
+    with mirror._pass_lock() as held:
+        assert held
+        report = run(tmp_path / "m", FakeDrive([doc("DOC1", "Plan")]))
+    assert report.imported == [] and not (tmp_path / "m").exists()
+    assert len(run(tmp_path / "m", FakeDrive([doc("DOC1", "Plan")])).imported) == 1
