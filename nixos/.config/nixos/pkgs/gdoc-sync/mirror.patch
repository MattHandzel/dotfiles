diff --git a/src/gdoc_sync/mirror.py b/src/gdoc_sync/mirror.py
new file mode 100644
index 0000000..c0193c1
--- /dev/null
+++ b/src/gdoc_sync/mirror.py
@@ -0,0 +1,277 @@
+"""Keep one folder in step with every Google Doc in the account.
+
+`import` brings in a doc you name. `mirror` brings in all of them: each Google
+Doc the account owns or has opened that is not linked to a file yet becomes a
+pull-only file in one folder, and a mirrored file is pulled again when its doc
+changes.
+
+Cost decides the design. `sync --all` asks the Docs API for every linked doc's
+revisionId on every pass — one request per file — and Google moves that id on
+autosave, cursor movement and presence, so many of those "changes" cost a full
+render for nothing. Over a whole account (about a thousand docs) that is a
+thousand Docs reads per pass against a per-user quota of 300 a minute.
+`mirror` makes one paged Drive ``files.list`` instead (a thousand docs per
+page), which returns every doc's ``modifiedTime``, and renders only the docs
+whose time moved since the last pass. An idle pass over a thousand docs is two
+requests.
+
+Mirrored files are recorded under ``mirrored:`` in the state file, keyed by
+doc id. `sync --all` and `watch --all` skip them, so they never cost a peek.
+A mirrored file that has been deleted or moved is left alone, never imported
+again: removing it is how a doc is dropped from the mirror.
+"""
+
+from __future__ import annotations
+
+import contextlib
+import datetime
+import os
+from dataclasses import dataclass, field
+from pathlib import Path
+
+from .config import (
+    expand_state_key,
+    load_state,
+    mutate_state,
+    set_revision,
+    state_key,
+    state_path,
+)
+from .importer import import_doc, slugify
+from .pull import render_doc
+from .services import NUM_RETRIES, get_services
+from .sync import reconcile
+
+DOC_MIME = "application/vnd.google-apps.document"
+
+# A doc made by `gdoc-sync create` exists in Drive for a moment before its
+# mapping is saved. A pass that lands in that window would import a second
+# copy of a file the user already has, so brand-new docs wait for the next pass.
+MIN_AGE = datetime.timedelta(minutes=10)
+
+# A doc that failed to import (no read access to its content, a render error)
+# is retried once a day rather than on every pass.
+RETRY_FAILED_AFTER = datetime.timedelta(days=1)
+
+DEFAULT_LIMIT = 50
+
+
+@dataclass
+class MirrorReport:
+    listed: int = 0
+    imported: list[str] = field(default_factory=list)
+    refreshed: list[str] = field(default_factory=list)
+    failed: list[str] = field(default_factory=list)
+    conflicted: list[str] = field(default_factory=list)
+    pending: int = 0
+
+    def summary(self) -> str:
+        return (f"mirror: {self.listed} docs in Drive — imported {len(self.imported)}, "
+                f"refreshed {len(self.refreshed)}, failed {len(self.failed)}, "
+                f"conflicted {len(self.conflicted)}, still to import {self.pending}")
+
+
+def _now() -> datetime.datetime:
+    return datetime.datetime.now(datetime.timezone.utc)
+
+
+def _parse_time(value: str) -> datetime.datetime:
+    return datetime.datetime.fromisoformat(value.replace("Z", "+00:00"))
+
+
+def list_docs(drive) -> list[dict]:
+    """Every Google Doc the account owns or has opened, most recent first.
+
+    Docs that were only shared with the account and never opened are left out:
+    they are in Drive's "Shared with me" list, not in anything the user would
+    call their documents.
+    """
+    docs: list[dict] = []
+    token = None
+    while True:
+        resp = drive.files().list(
+            q=f"mimeType='{DOC_MIME}' and trashed=false",
+            fields="nextPageToken, files(id,name,createdTime,modifiedTime,"
+                   "ownedByMe,viewedByMeTime)",
+            pageSize=1000,
+            pageToken=token,
+            corpora="allDrives",
+            includeItemsFromAllDrives=True,
+            supportsAllDrives=True,
+        ).execute(num_retries=NUM_RETRIES)
+        docs.extend(resp.get("files", []))
+        token = resp.get("nextPageToken")
+        if not token:
+            break
+    mine = [d for d in docs if d.get("ownedByMe") or d.get("viewedByMeTime")]
+    mine.sort(key=lambda d: max(d.get("viewedByMeTime") or "", d.get("modifiedTime") or ""),
+              reverse=True)
+    return mine
+
+
+def mirrored_paths() -> set[str]:
+    """Absolute paths of the files the mirror owns (for `sync --all` to skip)."""
+    entries = load_state().get("mirrored") or {}
+    return {expand_state_key(e["file"]) for e in entries.values()
+            if isinstance(e, dict) and e.get("file")}
+
+
+def _record(doc_id: str, entry: dict) -> None:
+    def apply(state: dict) -> bool:
+        state.setdefault("mirrored", {})[doc_id] = entry
+        return True
+    mutate_state(apply)
+
+
+def _free_path(dest: Path, title: str, doc_id: str, taken: set[Path]) -> Path:
+    """``<slug>.md`` in ``dest``, or ``<slug>-<id prefix>.md`` when that is taken.
+
+    Many docs share a title ("Untitled document", a recurring meeting name), and
+    the import must never overwrite a file it did not write.
+    """
+    slug = slugify(title)
+    for stem in (slug, f"{slug}-{doc_id[:8]}", f"{slug}-{doc_id}"):
+        candidate = (dest / f"{stem}.md").resolve()
+        if candidate not in taken and not candidate.exists():
+            return candidate
+    raise FileExistsError(f"no free filename for {title!r} in {dest}")
+
+
+def _refresh(path: Path, doc_id: str, say) -> object:
+    """Pull one mirrored doc through the normal merge (never pushes)."""
+    def never_push(*_a, **_k):
+        raise RuntimeError("mirror never pushes")
+
+    outcome = reconcile(
+        path, doc_id,
+        render=lambda p: render_doc(doc_id, asset_path=p),
+        push=never_push,
+        allow_push=False,
+        say=say,
+    )
+    if outcome.revision:
+        set_revision(str(path), outcome.revision)
+    return outcome
+
+
+@contextlib.contextmanager
+def _pass_lock():
+    """Hold the mirror's own lock for a whole pass; yield False if it is taken.
+
+    Two overlapping passes (a long first import and the next timer tick) would
+    both see the same unlinked doc and both import it, the second under a
+    ``-<id>`` name. The state lock cannot prevent that: it only spans each
+    single write, not the list-then-import of a pass.
+    """
+    try:
+        import fcntl
+    except ImportError:  # not POSIX: no lock, as with the state lock
+        yield True
+        return
+    lock_path = state_path().with_name(state_path().name + ".mirror.lock")
+    lock_path.parent.mkdir(parents=True, exist_ok=True)
+    fd = os.open(lock_path, os.O_RDWR | os.O_CREAT, 0o600)
+    try:
+        try:
+            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except BlockingIOError:
+            yield False
+            return
+        try:
+            yield True
+        finally:
+            fcntl.flock(fd, fcntl.LOCK_UN)
+    finally:
+        os.close(fd)
+
+
+def mirror(dest: Path, *, limit: int = DEFAULT_LIMIT, dry_run: bool = False,
+           say=print, drive=None) -> MirrorReport:
+    """One mirror pass: import unlinked docs into ``dest``, refresh changed ones."""
+    with _pass_lock() as acquired:
+        if not acquired:
+            say("mirror: another pass is still running — skipping this one")
+            return MirrorReport()
+        report = _mirror(dest, limit=limit, dry_run=dry_run, say=say, drive=drive)
+    say(("dry run, nothing written — " if dry_run else "") + report.summary())
+    return report
+
+
+def _mirror(dest: Path, *, limit: int, dry_run: bool, say, drive) -> MirrorReport:
+    dest = Path(dest).expanduser().resolve()
+    if drive is None:
+        drive, _ = get_services(interactive=False)
+    docs = list_docs(drive)
+    report = MirrorReport(listed=len(docs))
+
+    state = load_state()
+    linked = set((state.get("mappings") or {}).values())
+    ledger = dict(state.get("mirrored") or {})
+    now = _now()
+    taken: set[Path] = set()
+
+    for doc in docs:
+        doc_id, title = doc["id"], doc.get("name") or "Untitled"
+        modified = doc.get("modifiedTime") or ""
+        entry = ledger.get(doc_id)
+
+        # --- Already mirrored: pull only when Drive says the doc moved ------
+        if isinstance(entry, dict) and entry.get("file"):
+            path = Path(expand_state_key(entry["file"]))
+            if not path.exists() or modified <= entry.get("modified", ""):
+                continue
+            if dry_run:
+                report.refreshed.append(str(path))
+                continue
+            try:
+                outcome = _refresh(path, doc_id, say=lambda *_: None)
+            except Exception as e:  # noqa: BLE001 — one bad doc must not stop the pass
+                say(f"  refresh failed: {path.name}: {e}")
+                report.failed.append(str(path))
+                continue
+            if outcome.conflicted:
+                # Leave `modified` alone: the pass after the conflict is
+                # resolved has to pull again.
+                report.conflicted.append(str(path))
+                say(f"  conflict: {path.name}: {outcome.detail}")
+                continue
+            _record(doc_id, {**entry, "modified": modified})
+            if outcome.wrote_local:
+                report.refreshed.append(str(path))
+                say(f"  refreshed {path.name}")
+            continue
+
+        # --- Not ours to import -------------------------------------------
+        if doc_id in linked:
+            continue  # the user already has this doc linked somewhere
+        if isinstance(entry, dict) and entry.get("failed"):
+            if now - _parse_time(entry["failed"]) < RETRY_FAILED_AFTER:
+                continue
+        if doc.get("createdTime") and now - _parse_time(doc["createdTime"]) < MIN_AGE:
+            continue
+
+        # --- New doc -------------------------------------------------------
+        if len(report.imported) + len(report.failed) >= limit:
+            report.pending += 1
+            continue
+        try:
+            path = _free_path(dest, title, doc_id, taken)
+        except FileExistsError as e:
+            say(f"  skipped {title!r}: {e}")
+            continue
+        taken.add(path)
+        if dry_run:
+            report.imported.append(str(path))
+            continue
+        try:
+            import_doc(doc_id, output=path, pull_only=True, say=lambda *_: None)
+        except Exception as e:  # noqa: BLE001
+            say(f"  import failed: {title!r} ({doc_id}): {e}")
+            report.failed.append(title)
+            _record(doc_id, {"failed": now.isoformat(), "error": str(e)[:200]})
+            continue
+        _record(doc_id, {"file": state_key(path), "modified": modified})
+        report.imported.append(str(path))
+        say(f"  imported {path.name}")
+
+    return report
