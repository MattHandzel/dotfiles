#!/usr/bin/env bash
# SketchyBar — the waybar of this Mac.
#
# One flat strip along the top, Catppuccin Mocha on a solid base ground, no
# gaps, no rounded bar corners (gaps 0 everywhere else, the bar should sit
# flush too). The only saturated colour is the focused workspace, in Mauve, so
# the eye lands there first. Everything else is text-on-base with a soft
# accent glyph per item so the right side scans without reading.
#
#   left    workspaces (AeroSpace)  ·  front app + window title
#   notch   clock ◖notch◗ next calendar event   (q / e positions hug the notch;
#           on a notch-less display they sit either side of the centre line)
#   right   cpu  mem  battery  wifi  volume  tailscale
#
# Layout of this directory:
#   sketchybarrc   this file — bar geometry, defaults, items
#   colors.sh      the Mocha palette as 0xAARRGGBB
#   plugins/*.sh   one script per item; each writes back with `sketchybar --set`
#
# Owned by modules/home/darwin/sketchybar.nix in the flake; edits here are
# mirrored there. Reload with `sketchybar --reload`.

CONFIG_DIR="${CONFIG_DIR:-$HOME/.config/sketchybar}"
PLUGIN_DIR="$CONFIG_DIR/plugins"
source "$CONFIG_DIR/colors.sh"

FONT="JetBrainsMono Nerd Font"
APP_FONT="sketchybar-app-font"

# ── the bar ───────────────────────────────────────────────────────────────
# The built-in display has a 32pt notch strip that macOS never gives to
# windows; the bar fills it exactly so there is no dead band above the tiles.
# External displays get the waybar height (30). The bar is solid base: it is a
# frame, not a floating island.
sketchybar --bar \
  position=top \
  height=30 \
  notch_display_height=32 \
  notch_width=200 \
  color="$BASE" \
  border_width=0 \
  corner_radius=0 \
  margin=0 \
  y_offset=0 \
  padding_left=6 \
  padding_right=6 \
  blur_radius=0 \
  sticky=on \
  topmost=off \
  shadow=off \
  display=all

# ── defaults every item starts from ───────────────────────────────────────
sketchybar --default \
  updates=when_shown \
  drawing=on \
  icon.font="$FONT:Bold:13.0" \
  icon.color="$SUBTEXT0" \
  icon.padding_left=6 \
  icon.padding_right=3 \
  label.font="$FONT:Medium:12.0" \
  label.color="$TEXT" \
  label.padding_left=3 \
  label.padding_right=6 \
  padding_left=2 \
  padding_right=2 \
  background.color="$TRANSPARENT" \
  background.corner_radius=5 \
  background.height=22 \
  background.drawing=off

# ── events ────────────────────────────────────────────────────────────────
# AeroSpace fires this from `exec-on-workspace-change` in ~/.aerospace.toml
# with FOCUSED_WORKSPACE in the environment.
sketchybar --add event aerospace_workspace_change
# ~/.local/bin/oops fires this when it starts a Claude repair session.
sketchybar --add event oops_update

# ═══════════════════════════════ LEFT ═════════════════════════════════════

# Workspaces are dynamic: AeroSpace names them (1-20, slack, obsidian, …) and a
# named one only exists while it has windows. So the items themselves are
# created and pruned by plugins/aerospace.sh on every change; this hidden item
# is the one that listens. It also refreshes when the front app changes (a
# window moved) and on a slow timer as a safety net.
sketchybar --add item aerospace.updater left \
  --set aerospace.updater drawing=off \
    updates=on \
    update_freq=30 \
    script="$PLUGIN_DIR/aerospace.sh" \
  --subscribe aerospace.updater aerospace_workspace_change front_app_switched

# A fixed anchor: workspace items are always inserted *before* this, so the
# order left→right survives adds and removes. label.max_chars is re-set by
# front_app.sh from the room the workspace strip leaves before the clock.
# front_app is now a HIDDEN ANCHOR only. The app name + window title used to
# draw here; it was noise (you already know what you are looking at) so it is
# switched off. The item itself stays because plugins/aerospace.sh inserts every
# workspace pill `before front_app` to keep the strip ordered.
sketchybar --add item front_app left \
  --set front_app \
    drawing=off \
    updates=off \
    icon.drawing=off \
    label.drawing=off \
    background.drawing=off \
    width=0

# ═══════════════════════════ AROUND THE NOTCH ═════════════════════════════

# Clock: `EEE d MMM  HH:mm` — what the laptop showed, minus the seconds.
# Position q = right-aligned against the left edge of the notch.
sketchybar --add item clock q \
  --set clock \
    update_freq=10 \
    icon="󰃭" \
    icon.color="$MAUVE" \
    label.font="$FONT:SemiBold:12.5" \
    label.padding_right=10 \
    script="$PLUGIN_DIR/clock.sh"

# Today's next event. Reads the read-only Google agenda the calendar-agenda
# launchd agent writes (same file waybar read on the laptop); falls back to
# icalBuddy against Calendar.app; hides itself when there is nothing.
# Position e = left-aligned against the right edge of the notch.
sketchybar --add item calendar e \
  --set calendar \
    update_freq=120 \
    icon="󰸗" \
    icon.color="$TEAL" \
    icon.padding_left=10 \
    label.color="$SUBTEXT1" \
    label.max_chars=34 \
    click_script="open -a Calendar" \
    script="$PLUGIN_DIR/calendar.sh"

# ══════════════════════════════ RIGHT ═════════════════════════════════════
# Right items are added right-to-left (first added = rightmost), so this
# reads: tailscale · volume · wifi · battery · memory · cpu on screen.

# Tailscale: a dot. Green when the tailnet is up, red when it is not.
sketchybar --add item tailscale right \
  --set tailscale \
    update_freq=30 \
    icon="●" \
    icon.font="$FONT:Bold:9.0" \
    icon.padding_left=8 \
    icon.padding_right=6 \
    label.drawing=off \
    click_script="open -a Tailscale" \
    script="$PLUGIN_DIR/tailscale.sh"

sketchybar --add item volume right \
  --set volume \
    icon.color="$LAVENDER" \
    icon.font="$FONT:Bold:14.0" \
    icon.width=22 \
    icon.align=center \
    script="$PLUGIN_DIR/volume.sh" \
  --subscribe volume volume_change

sketchybar --add item wifi right \
  --set wifi \
    update_freq=15 \
    icon.color="$BLUE" \
    label.max_chars=18 \
    click_script="open 'x-apple.systempreferences:com.apple.wifi-settings-extension'" \
    script="$PLUGIN_DIR/wifi.sh" \
  --subscribe wifi wifi_change system_woke

sketchybar --add item battery right \
  --set battery \
    update_freq=60 \
    icon.color="$GREEN" \
    icon.font="$FONT:Bold:14.0" \
    script="$PLUGIN_DIR/battery.sh" \
  --subscribe battery power_source_change system_woke

sketchybar --add item memory right \
  --set memory \
    update_freq=10 \
    icon="󰾆" \
    icon.color="$YELLOW" \
    script="$PLUGIN_DIR/memory.sh"

sketchybar --add item cpu right \
  --set cpu \
    update_freq=5 \
    icon="󰍛" \
    icon.color="$PEACH" \
    click_script="open -na kitty --args --title btop -e btop" \
    script="$PLUGIN_DIR/cpu.sh"

# Oops: red life-ring + count while a Claude repair session runs (tmux -L oops);
# hidden otherwise. Added last so it sits leftmost of the right cluster. Click
# jumps to the "oops" workspace where the session's terminal is parked.
sketchybar --add item oops right \
  --set oops \
    drawing=off \
    update_freq=10 \
    icon="" \
    icon.color="$RED" \
    icon.font="$FONT:Bold:13.0" \
    label.color="$TEXT" \
    click_script="$PLUGIN_DIR/oops.sh click" \
    script="$PLUGIN_DIR/oops.sh" \
  --subscribe oops oops_update

# Focus Mode pill: peach "󱫠 Focus" when on, a dim glyph when off. Click to
# toggle. Its 60 s timer also turns focus on during Deep work calendar blocks
# (plugins/focus.sh). Added last so it sits leftmost of the right cluster.
sketchybar --add item focus right \
  --set focus \
    update_freq=60 \
    icon="󱫪" \
    icon.font="$FONT:Bold:14.0" \
    icon.padding_left=8 \
    label.font="$FONT:SemiBold:12.0" \
    label.drawing=off \
    background.height=22 \
    click_script="$PLUGIN_DIR/focus.sh click" \
    script="$PLUGIN_DIR/focus.sh" \
  --subscribe focus aerospace_workspace_change system_woke

# ── go ────────────────────────────────────────────────────────────────────
sketchybar --update

# Draw the workspaces once now rather than waiting for the first switch.
"$PLUGIN_DIR/aerospace.sh"
